APP_ENV=prod
APP_LOG_LEVEL=info

# API key for Flutter app (x-api-key header). Can match SWAP_API_KEY.
BRIDGE_API_KEY=change-me

# Inside docker-compose use the service hostname:
# SWAP_API_BASE=http://toncoin-cash-swap:8085
SWAP_API_BASE=http://127.0.0.1:8085
SWAP_API_KEY=change-me

CORS_ALLOW_ORIGINS=*
